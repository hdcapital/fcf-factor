# Copy to .env for local use. NEVER commit a real .env - it is gitignored.
# In GitHub Actions these are repository secrets, not files.

# --- SMTP (quarterly emails) ---------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail this must be a 16-character App Password, not your account password.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com

# --- Optional provider tuning --------------------------------------------
# PROVIDER_MAX_WORKERS=4
# PROVIDER_REQUEST_PAUSE=0.25
# CACHE_TTL_HOURS=20
# FCF_LOG_LEVEL=INFO

# --- Optional factor overrides (they change the config hash) --------------
# MIN_MARKET_CAP_USD=50000000
# MAX_STOCK_WEIGHT=0.03
# TRANSACTION_COST_BPS=0
